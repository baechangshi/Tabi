rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // 악보 메타데이터 검증 (목록에 표시되는 정보)
    function validMeta(d) {
      return d.keys().hasOnly(['title','titleLower','artist','instrument','tuning','capo','tempo',
                               'measureCount','ownerUid','ownerName','keywords','createdAt','updatedAt','forkOf'])
        && d.keys().hasAll(['title','titleLower','artist','instrument','ownerUid','ownerName','keywords','createdAt','updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.titleLower is string && d.titleLower.size() <= 120
        && d.artist is string && d.artist.size() <= 120
        && d.instrument in ['guitar', 'bass4', 'bass5']
        && d.ownerUid == request.auth.uid
        && d.ownerName is string && d.ownerName.size() <= 80
        && d.keywords is list && d.keywords.size() <= 300
        && d.updatedAt == request.time;
    }

    // 목록용 메타데이터: 누구나 읽기, 로그인 사용자만 작성, 본인 것만 수정·삭제
    match /tabs/{tabId} {
      allow read: if true;
      allow create: if signedIn() && validMeta(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
                    && validMeta(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // 악보 본문: 메타데이터와 같은 주인만 작성 가능 (같은 배치로 저장)
    match /tabBodies/{tabId} {
      allow read: if true;
      allow create, update: if signedIn()
                    && request.resource.data.keys().hasOnly(['ownerUid','body','updatedAt'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.body is string
                    && request.resource.data.body.size() < 900000
                    && (resource == null || resource.data.ownerUid == request.auth.uid)
                    && getAfter(/databases/$(database)/documents/tabs/$(tabId)).data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
